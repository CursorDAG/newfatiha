# Database
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=10
# IMPORTANT: Add connection_limit parameter to prevent connection pool exhaustion
# Recommended: 10 for development, 20-50 for production (depending on server resources)
DATABASE_URL="postgresql://fatiha_user:fatiha_pass@localhost:5432/fatiha_db?connection_limit=10"

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
# CRITICAL: Never commit the actual secret to git
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Application URL
# Use http://localhost:3000 for development
# Use your production domain for production (e.g., https://fatiha.ru)
NEXTAUTH_URL="http://localhost:3000"

# Logging
# Log level: trace, debug, info, warn, error, fatal
# Default: debug in development, info in production
LOG_LEVEL="debug"

# Optional: Jitsi Configuration
# If using self-hosted Jitsi with JWT authentication instead of meet.jit.si
# Leave these empty to use public meet.jit.si without authentication
# JITSI_DOMAIN: Your Jitsi server domain (e.g., "meet.yourdomain.com")
# JITSI_JWT_APP_ID: Application ID configured in Jitsi (must match prosody config)
# JITSI_JWT_SECRET: Secret key for signing JWT tokens (must match prosody config)
# Generate secret with: openssl rand -base64 32
# JITSI_DOMAIN="meet.yourdomain.com"
# JITSI_JWT_APP_ID="fatiha_lms"
# JITSI_JWT_SECRET="your-jwt-secret-generate-with-openssl-rand-base64-32"

# Optional: S3-Compatible Storage (AWS S3, MinIO, Cloudflare R2)
# Required for voice quiz recordings. If not configured, recordings are stored in PostgreSQL (not recommended for production)
# S3_ENDPOINT: Optional, only needed for MinIO or other S3-compatible services (leave empty for AWS S3)
# S3_PUBLIC_URL: Optional, base URL for public access (e.g., "https://cdn.yourdomain.com")
# S3_BUCKET="fatiha-voice-recordings"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="your-access-key"
# S3_SECRET_ACCESS_KEY="your-secret-key"
# S3_ENDPOINT="https://s3.yourdomain.com"  # Only for MinIO/custom S3
# S3_PUBLIC_URL="https://cdn.yourdomain.com"  # Optional public CDN URL

# Optional: Redis (for caching)
# REDIS_URL="redis://localhost:6379"

# Optional: Sentry (for error tracking)
# Get your DSN from https://sentry.io/
# SENTRY_DSN is used server-side and in edge runtime
# NEXT_PUBLIC_SENTRY_DSN is used client-side (browser)
# SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
# NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# Email Configuration (for notifications)
# For development: Use Ethereal Email (https://ethereal.email) - auto-generated test accounts
# For production: Use your SMTP provider (Gmail, SendGrid, AWS SES, Mail.ru, etc.)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_USER="your-ethereal-user@ethereal.email"
SMTP_PASS="your-ethereal-password"
SMTP_FROM="noreply@fatiha.ru"
SMTP_FROM_NAME="Fatiha.ru"
