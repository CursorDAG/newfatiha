# Database
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://fatiha_user:fatiha_pass@localhost:5432/fatiha_db"

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
# CRITICAL: Never commit the actual secret to git
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Application URL
# Use http://localhost:3000 for development
# Use your production domain for production (e.g., https://fatiha.ru)
NEXTAUTH_URL="http://localhost:3000"

# Optional: Jitsi Configuration
# If using self-hosted Jitsi instead of meet.jit.si
# JITSI_DOMAIN="meet.yourdomain.com"
# JITSI_JWT_APP_ID="your-app-id"
# JITSI_JWT_SECRET="your-jwt-secret"

# Optional: File Storage (for future S3 migration)
# S3_BUCKET="fatiha-voice-recordings"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="your-access-key"
# S3_SECRET_ACCESS_KEY="your-secret-key"

# Optional: Redis (for caching)
# REDIS_URL="redis://localhost:6379"

# Optional: Sentry (for error tracking)
# SENTRY_DSN="https://your-sentry-dsn"

# Optional: Email (for notifications)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
