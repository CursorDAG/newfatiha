generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                  @id @default(uuid())
  email                      String                  @unique
  password                   String?
  name                       String
  role                       Role                    @default(STUDENT)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  avatar                     String?
  bio                        String?
  skills                     String[]
  deletedAt                  DateTime?
  gender                     Gender                  @default(NOT_SPECIFIED)
  isBlocked                  Boolean                 @default(false)
  emailVerified              Boolean                 @default(false)
  emailVerifiedAt            DateTime?
  status                     UserStatus              @default(ACTIVE)
  verificationToken          String?                 @unique
  hasanatBalance             Int                     @default(0)
  totalHasanatEarned         Int                     @default(0)
  activitySessions           ActivitySession[]
  broadcasts                 Broadcast[]
  chatMessages               ChatMessage[]
  chatParticipant1Rooms      ChatRoom[]              @relation("ChatParticipant1")
  chatParticipant2Rooms      ChatRoom[]              @relation("ChatParticipant2")
  contentReports             ContentReport[]
  reviewedReports            ContentReport[]         @relation("ReviewedReports")
  courses                    Course[]                @relation("TeacherCourses")
  courseBooks                CourseBook[]
  enrollments                Enrollment[]
  reviewedEnrollmentRequests EnrollmentRequest[]     @relation("ReviewedEnrollmentRequests")
  enrollmentRequests         EnrollmentRequest[]
  hasanatTransactions        HasanatTransaction[]
  leaderboardEntries         LeaderboardEntry[]
  checkedQuizSubmissions     LessonQuizSubmission[]  @relation("QuizCheckedBy")
  quizSubmissions            LessonQuizSubmission[]
  notifications              Notification[]
  notificationPreference     NotificationPreference?
  checkedQuestionSubmissions QuestionSubmission[]    @relation("QuestionCheckedBy")
  questionSubmissions        QuestionSubmission[]
  studentReviews             Review[]                @relation("StudentReviews")
  teacherReviews             Review[]                @relation("TeacherReviews")
  streaks                    Streak[]
  assignedTickets            SupportTicket[]         @relation("AssignedTickets")
  supportTickets             SupportTicket[]
  supportTicketReplies       SupportTicketReply[]
  reviewedTeacherProfiles    TeacherProfile[]        @relation("ReviewedTeacherProfiles")
  teacherProfile             TeacherProfile?
  userBookProgress           UserBookProgress[]
}

model TeacherProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  bio               String?
  subjects          String[]
  experience        String?
  qualifications    String?
  whatsappPhone     String?
  documentsUrls     String[]
  videoIntroUrl     String?
  adminNotes        String?
  reviewedById      String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  paymentRequisites String?
  reviewedBy        User?     @relation("ReviewedTeacherProfiles", fields: [reviewedById], references: [id])
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reviewedById])
}

model Course {
  id          String       @id @default(uuid())
  title       String
  description String?
  teacherId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  capacity    Int          @default(30)
  published   Boolean      @default(false)
  teacher     User         @relation("TeacherCourses", fields: [teacherId], references: [id])
  courseBooks CourseBook[]
  reviews     Review[]
  streams     Stream[]
}

model Stream {
  id                  String               @id @default(uuid())
  name                String
  level               String
  schedule            String
  teacherId           String
  courseId            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  color               String               @default("#10b981")
  chatEnabled         Boolean              @default(true)
  genderType          StreamGenderType     @default(MIXED)
  currency            String               @default("RUB")
  enrollmentDeadline  DateTime?
  isOpenForEnrollment Boolean              @default(false)
  paymentInstructions String?
  price               Decimal?             @db.Decimal(10, 2)
  chatRoom            ChatRoom?
  enrollments         Enrollment[]
  enrollmentRequests  EnrollmentRequest[]
  homeworkAssignments HomeworkAssignment[]
  inviteToken         InviteToken?
  leaderboardEntries  LeaderboardEntry[]
  lessons             Lesson[]
  course              Course               @relation(fields: [courseId], references: [id])
  scheduleSlots       StreamScheduleSlot[]
}

model StreamScheduleSlot {
  id              String   @id @default(uuid())
  streamId        String
  dayOfWeek       Int
  startMinutes    Int
  durationMinutes Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  stream          Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([dayOfWeek, startMinutes])
}

model Enrollment {
  id                  String               @id @default(uuid())
  userId              String
  streamId            String
  status              EnrollmentStatus     @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  stream              Stream               @relation(fields: [streamId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  homeworkSubmissions HomeworkSubmission[]

  @@unique([userId, streamId])
}

model EnrollmentRequest {
  id                 String                  @id @default(uuid())
  studentId          String
  streamId           String
  status             EnrollmentRequestStatus @default(PENDING_REVIEW)
  message            String?
  reviewedById       String?
  reviewedAt         DateTime?
  rejectionReason    String?
  paymentConfirmed   Boolean                 @default(false)
  paymentConfirmedAt DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  reviewedBy         User?                   @relation("ReviewedEnrollmentRequests", fields: [reviewedById], references: [id])
  stream             Stream                  @relation(fields: [streamId], references: [id], onDelete: Cascade)
  student            User                    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, streamId])
  @@index([studentId])
  @@index([streamId])
  @@index([status])
}

model InviteToken {
  id        String    @id @default(uuid())
  token     String    @unique @default(uuid())
  streamId  String    @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  stream    Stream    @relation(fields: [streamId], references: [id])
}

model Lesson {
  id                  String               @id @default(uuid())
  title               String
  type                LessonType
  content             String?
  streamId            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sortOrder           Int                  @default(0)
  teacherNotes        String?
  isTemplate          Boolean              @default(false)
  level               String?
  published           Boolean              @default(true)
  topic               String?
  homeworks           Homework[]
  homeworkAssignments HomeworkAssignment[]
  stream              Stream               @relation(fields: [streamId], references: [id])
  progress            LessonProgress[]
  quizzes             LessonQuiz[]
  recordings          LessonRecording[]
}

model LessonQuiz {
  id          String                 @id @default(uuid())
  lessonId    String
  title       String
  type        QuizType
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  lesson      Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions   LessonQuizQuestion[]
  submissions LessonQuizSubmission[]
}

model LessonQuizQuestion {
  id                  String               @id @default(uuid())
  quizId              String
  prompt              String
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  type                QuestionType         @default(MULTIPLE_CHOICE)
  options             LessonQuizOption[]
  quiz                LessonQuiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionSubmissions QuestionSubmission[]
}

model LessonQuizOption {
  id         String             @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean            @default(false)
  sortOrder  Int                @default(0)
  question   LessonQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model LessonQuizSubmission {
  id               String               @id @default(uuid())
  quizId           String
  studentId        String
  selectedOptionId String?
  voiceMimeType    String?
  voiceData        Bytes?
  voiceDurationMs  Int?
  status           QuizSubmissionStatus @default(SUBMITTED)
  checkedById      String?
  checkedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  voiceUrl         String?
  questionDetails  Json?
  checkedBy        User?                @relation("QuizCheckedBy", fields: [checkedById], references: [id])
  quiz             LessonQuiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student          User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
  @@index([studentId, createdAt])
  @@index([quizId, createdAt])
}

model QuestionSubmission {
  id               String               @id @default(uuid())
  questionId       String
  studentId        String
  selectedOptionId String?
  textAnswer       String?
  voiceMimeType    String?
  voiceData        Bytes?
  voiceDurationMs  Int?
  voiceUrl         String?
  status           QuizSubmissionStatus @default(SUBMITTED)
  checkedById      String?
  checkedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  checkedBy        User?                @relation("QuestionCheckedBy", fields: [checkedById], references: [id])
  question         LessonQuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student          User                 @relation(fields: [studentId], references: [id])

  @@unique([questionId, studentId])
  @@index([studentId, createdAt])
  @@index([questionId, createdAt])
}

model LessonRecording {
  id           String          @id @default(uuid())
  lessonId     String
  streamId     String
  videoUrl     String
  thumbnailUrl String?
  duration     Int?
  fileSize     BigInt?
  recordedAt   DateTime        @default(now())
  processedAt  DateTime?
  status       RecordingStatus @default(PROCESSING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  lesson       Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([streamId])
  @@index([status])
}

model LessonProgress {
  id             String    @id @default(uuid())
  userId         String
  lessonId       String
  streamId       String
  watchedSeconds Int       @default(0)
  totalSeconds   Int?
  completed      Boolean   @default(false)
  lastWatchedAt  DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, streamId])
  @@index([lessonId])
}

model StudentProgress {
  id                    String   @id @default(uuid())
  userId                String
  streamId              String
  lessonsCompleted      Int      @default(0)
  lessonsTotal          Int      @default(0)
  quizzesPassed         Int      @default(0)
  quizzesTotal          Int      @default(0)
  homeworksAccepted     Int      @default(0)
  homeworksTotal        Int      @default(0)
  averageQuizScore      Float?
  totalWatchTimeSeconds Int      @default(0)
  lastActivityAt        DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, streamId])
  @@index([streamId])
  @@index([userId])
}

model ActivitySession {
  id         String       @id @default(uuid())
  userId     String
  kind       ActivityKind
  streamId   String?
  lessonId   String?
  startedAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())
  endedAt    DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([streamId, startedAt])
  @@index([lessonId, startedAt])
}

model Homework {
  id        String   @id @default(uuid())
  title     String
  lessonId  String
  audioUrl  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model HomeworkAssignment {
  id          String               @id @default(uuid())
  streamId    String
  lessonId    String?
  title       String
  description String?
  type        HomeworkType         @default(TEXT)
  dueAt       DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  lesson      Lesson?              @relation(fields: [lessonId], references: [id])
  stream      Stream               @relation(fields: [streamId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]

  @@index([streamId])
  @@index([lessonId])
}

model HomeworkSubmission {
  id              String                   @id @default(uuid())
  assignmentId    String
  enrollmentId    String
  status          HomeworkSubmissionStatus @default(SUBMITTED)
  grade           Int?
  teacherComment  String?
  contentText     String?
  contentUrl      String?
  submittedAt     DateTime                 @default(now())
  checkedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  voiceData       Bytes?
  voiceDurationMs Int?
  voiceMimeType   String?
  voiceUrl        String?
  assignment      HomeworkAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  enrollment      Enrollment               @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, enrollmentId])
  @@index([enrollmentId])
}

model Notification {
  id          String               @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  link        String?
  read        Boolean              @default(false)
  createdAt   DateTime             @default(now())
  actionText  String?
  actionUrl   String?
  emailSent   Boolean              @default(false)
  emailSentAt DateTime?
  metadata    Json?
  priority    NotificationPriority @default(NORMAL)
  readAt      DateTime?
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@index([priority, createdAt])
}

model NotificationPreference {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  emailNewLesson         Boolean  @default(true)
  emailHomeworkAssigned  Boolean  @default(true)
  emailHomeworkChecked   Boolean  @default(true)
  emailQuizChecked       Boolean  @default(true)
  emailAnnouncement      Boolean  @default(true)
  emailHomeworkSubmitted Boolean  @default(true)
  emailQuizSubmitted     Boolean  @default(true)
  emailStudentJoined     Boolean  @default(true)
  emailDigestEnabled     Boolean  @default(false)
  emailDigestTime        Int      @default(540)
  soundEnabled           Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SupportTicket {
  id           String                @id @default(uuid())
  userId       String
  subject      String
  description  String
  status       SupportTicketStatus   @default(OPEN)
  priority     SupportTicketPriority @default(MEDIUM)
  assignedToId String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  resolvedAt   DateTime?
  assignedTo   User?                 @relation("AssignedTickets", fields: [assignedToId], references: [id])
  user         User                  @relation(fields: [userId], references: [id])
  replies      SupportTicketReply[]

  @@index([userId])
  @@index([assignedToId])
  @@index([status, createdAt])
}

model SupportTicketReply {
  id        String        @id @default(uuid())
  ticketId  String
  userId    String
  message   String
  isStaff   Boolean       @default(false)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@index([ticketId, createdAt])
}

model ContentReport {
  id           String              @id @default(uuid())
  reporterId   String
  contentType  ContentReportType
  contentId    String
  reason       ContentReportReason
  description  String?
  status       ContentReportStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  reporter     User                @relation(fields: [reporterId], references: [id])
  reviewedBy   User?               @relation("ReviewedReports", fields: [reviewedById], references: [id])

  @@index([reporterId])
  @@index([reviewedById])
  @@index([status, createdAt])
  @@index([contentType, contentId])
}

model ChatRoom {
  id             String        @id @default(uuid())
  type           ChatRoomType
  streamId       String?       @unique
  participant1Id String?
  participant2Id String?
  createdAt      DateTime      @default(now())
  messages       ChatMessage[]
  participant1   User?         @relation("ChatParticipant1", fields: [participant1Id], references: [id])
  participant2   User?         @relation("ChatParticipant2", fields: [participant2Id], references: [id])
  stream         Stream?       @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@unique([participant1Id, participant2Id])
  @@index([streamId])
}

model ChatMessage {
  id        String    @id @default(uuid())
  roomId    String
  senderId  String
  content   String
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id])

  @@index([roomId, createdAt])
  @@index([senderId])
}

model Review {
  id        String       @id @default(uuid())
  studentId String
  courseId  String
  teacherId String
  streamId  String?
  rating    Int
  comment   String?
  status    ReviewStatus @default(PUBLISHED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User         @relation("StudentReviews", fields: [studentId], references: [id], onDelete: Cascade)
  teacher   User         @relation("TeacherReviews", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId, status])
  @@index([teacherId, status])
  @@index([status, createdAt])
}

model PageContent {
  id        String   @id @default(uuid())
  page      String   @unique
  sections  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([page])
}

model Broadcast {
  id             String               @id @default(uuid())
  title          String
  message        String
  targetAudience Json
  priority       NotificationPriority @default(NORMAL)
  sendEmail      Boolean              @default(false)
  sentById       String
  sentAt         DateTime             @default(now())
  recipientCount Int                  @default(0)
  readCount      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  sentBy         User                 @relation(fields: [sentById], references: [id])

  @@index([sentById])
  @@index([sentAt])
}

model PlatformSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model LibraryCategory {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  description String?
  icon        String?
  order       Int               @default(0)
  parentId    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  books       Book[]
  parent      LibraryCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    LibraryCategory[] @relation("CategoryHierarchy")

  @@index([slug])
  @@index([parentId])
  @@index([order])
}

model Book {
  id              String             @id @default(uuid())
  title           String
  titleArabic     String?
  author          String?
  authorArabic    String?
  description     String?
  categoryId      String
  language        String             @default("ar")
  coverImage      String?
  sourceType      BookSourceType     @default(TEXT)
  sourceUrl       String?
  isOpenSource    Boolean            @default(true)
  license         String?
  allowSelfStudy  Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  category        LibraryCategory    @relation(fields: [categoryId], references: [id])
  chapters        BookChapter[]
  translations    BookTranslation[]
  courseBooks     CourseBook[]
  selfStudyCourse SelfStudyCourse?
  userProgress    UserBookProgress[]

  @@index([categoryId])
  @@index([language])
  @@index([allowSelfStudy])
}

model BookChapter {
  id           String            @id @default(uuid())
  bookId       String
  number       Int
  title        String
  titleArabic  String?
  content      Json
  order        Int
  createdAt    DateTime          @default(now())
  book         Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  translations BookTranslation[]

  @@unique([bookId, number])
  @@index([bookId, order])
}

model BookTranslation {
  id             String              @id @default(uuid())
  bookId         String
  chapterId      String?
  language       String
  translatorName String?
  content        Json
  type           BookTranslationType @default(TRANSLATION)
  createdAt      DateTime            @default(now())
  book           Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter        BookChapter?        @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([bookId, language])
  @@index([chapterId])
}

model CourseBook {
  id         String   @id @default(uuid())
  courseId   String
  bookId     String
  isRequired Boolean  @default(true)
  order      Int      @default(0)
  addedById  String
  createdAt  DateTime @default(now())
  addedBy    User     @relation(fields: [addedById], references: [id])
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, bookId])
  @@index([courseId, order])
  @@index([bookId])
}

model SelfStudyCourse {
  id               String   @id @default(uuid())
  title            String
  description      String
  bookId           String   @unique
  lessonsStructure Json
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  book             Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model UserBookProgress {
  id                String   @id @default(uuid())
  userId            String
  bookId            String
  lastChapterId     String?
  lastReadAt        DateTime @default(now())
  completedChapters Int[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  book              Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}

model Streak {
  id             String     @id @default(uuid())
  userId         String
  type           StreakType
  currentStreak  Int        @default(0)
  maxStreak      Int        @default(0)
  lastActiveDate DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId, type])
}

model LeaderboardEntry {
  id            String   @id @default(uuid())
  streamId      String
  userId        String
  xp            Int      @default(0)
  streak        Int      @default(0)
  weeklyHasanat Int      @default(0)
  weekStart     DateTime
  rank          Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  stream        Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([streamId, userId, weekStart])
  @@index([streamId, weekStart, rank])
  @@index([streamId, weekStart, xp])
}

model HasanatTransaction {
  id        String                 @id @default(uuid())
  userId    String
  type      HasanatTransactionType
  amount    Int
  reason    String
  createdAt DateTime               @default(now())
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  MODERATOR
}

enum UserStatus {
  PENDING_VERIFICATION
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

enum StreamGenderType {
  MALE_ONLY
  FEMALE_ONLY
  MIXED
}

