generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                  @id @default(uuid())
  email                    String                  @unique
  password                 String?
  name                     String
  role                     Role                    @default(STUDENT)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  avatar                   String?
  bio                      String?
  skills                   String[]
  isBlocked                Boolean                 @default(false)
  deletedAt                DateTime?
  gender                   Gender                  @default(NOT_SPECIFIED)
  emailVerified            Boolean                 @default(false)
  emailVerifiedAt          DateTime?
  verificationToken        String?                 @unique
  status                   UserStatus              @default(ACTIVE)
  activitySessions         ActivitySession[]
  courses                  Course[]                @relation("TeacherCourses")
  enrollments              Enrollment[]
  checkedQuizSubmissions   LessonQuizSubmission[]  @relation("QuizCheckedBy")
  quizSubmissions          LessonQuizSubmission[]
  notifications            Notification[]
  notificationPreference   NotificationPreference?
  supportTickets           SupportTicket[]
  assignedTickets          SupportTicket[]         @relation("AssignedTickets")
  supportTicketReplies     SupportTicketReply[]
  contentReports           ContentReport[]
  reviewedReports          ContentReport[]         @relation("ReviewedReports")
  chatParticipant1Rooms    ChatRoom[]              @relation("ChatParticipant1")
  chatParticipant2Rooms    ChatRoom[]              @relation("ChatParticipant2")
  chatMessages             ChatMessage[]
  questionSubmissions      QuestionSubmission[]
  checkedQuestionSubmissions QuestionSubmission[]  @relation("QuestionCheckedBy")
  teacherProfile           TeacherProfile?
  reviewedTeacherProfiles  TeacherProfile[]        @relation("ReviewedTeacherProfiles")
  enrollmentRequests       EnrollmentRequest[]
  reviewedEnrollmentRequests EnrollmentRequest[]   @relation("ReviewedEnrollmentRequests")
  broadcasts               Broadcast[]
}

model TeacherProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String?   @db.Text
  subjects        String[]
  experience      String?   @db.Text
  qualifications  String?   @db.Text
  whatsappPhone   String?
  documentsUrls   String[]
  videoIntroUrl   String?
  adminNotes      String?   @db.Text
  reviewedById    String?
  reviewedBy      User?     @relation("ReviewedTeacherProfiles", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([reviewedById])
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String?
  teacherId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  capacity    Int      @default(30)
  published   Boolean  @default(false)
  teacher     User     @relation("TeacherCourses", fields: [teacherId], references: [id])
  streams     Stream[]
}

model Stream {
  id                  String               @id @default(uuid())
  name                String
  level               String
  schedule            String
  teacherId           String
  courseId            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  color               String               @default("#10b981")
  genderType          StreamGenderType     @default(MIXED)
  chatEnabled         Boolean              @default(true)
  isOpenForEnrollment Boolean              @default(false)
  price               Decimal?             @db.Decimal(10, 2)
  currency            String               @default("RUB")
  enrollmentDeadline  DateTime?
  paymentInstructions String?              @db.Text
  enrollments         Enrollment[]
  homeworkAssignments HomeworkAssignment[]
  inviteToken         InviteToken?
  lessons             Lesson[]
  course              Course               @relation(fields: [courseId], references: [id])
  scheduleSlots       StreamScheduleSlot[]
  chatRoom            ChatRoom?
  enrollmentRequests  EnrollmentRequest[]
}

model StreamScheduleSlot {
  id              String   @id @default(uuid())
  streamId        String
  dayOfWeek       Int
  startMinutes    Int
  durationMinutes Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  stream          Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([dayOfWeek, startMinutes])
}

model Enrollment {
  id                  String               @id @default(uuid())
  userId              String
  streamId            String
  status              EnrollmentStatus     @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  stream              Stream               @relation(fields: [streamId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  homeworkSubmissions HomeworkSubmission[]

  @@unique([userId, streamId])
}

model EnrollmentRequest {
  id                    String                    @id @default(uuid())
  studentId             String
  streamId              String
  status                EnrollmentRequestStatus   @default(PENDING_REVIEW)
  message               String?                   @db.Text
  reviewedById          String?
  reviewedAt            DateTime?
  rejectionReason       String?                   @db.Text
  paymentConfirmed      Boolean                   @default(false)
  paymentConfirmedAt    DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  student               User                      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stream                Stream                    @relation(fields: [streamId], references: [id], onDelete: Cascade)
  reviewedBy            User?                     @relation("ReviewedEnrollmentRequests", fields: [reviewedById], references: [id])

  @@unique([studentId, streamId])
  @@index([studentId])
  @@index([streamId])
  @@index([status])
}

model InviteToken {
  id        String    @id @default(uuid())
  token     String    @unique @default(uuid())
  streamId  String    @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  stream    Stream    @relation(fields: [streamId], references: [id])
}

model Lesson {
  id                  String               @id @default(uuid())
  title               String
  type                LessonType
  content             String?
  streamId            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sortOrder           Int                  @default(0)
  teacherNotes        String?
  isTemplate          Boolean              @default(false)
  level               String?
  published           Boolean              @default(true)
  topic               String?
  homeworks           Homework[]
  homeworkAssignments HomeworkAssignment[]
  stream              Stream               @relation(fields: [streamId], references: [id])
  quizzes             LessonQuiz[]
  recordings          LessonRecording[]
  progress            LessonProgress[]
}

model LessonQuiz {
  id          String                 @id @default(uuid())
  lessonId    String
  title       String
  type        QuizType
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  lesson      Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions   LessonQuizQuestion[]
  submissions LessonQuizSubmission[]
}

model LessonQuizQuestion {
  id                String                 @id @default(uuid())
  quizId            String
  prompt            String
  type              QuestionType           @default(MULTIPLE_CHOICE)
  sortOrder         Int                    @default(0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  options           LessonQuizOption[]
  quiz              LessonQuiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionSubmissions QuestionSubmission[]
}

model LessonQuizOption {
  id         String             @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean            @default(false)
  sortOrder  Int                @default(0)
  question   LessonQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model LessonQuizSubmission {
  id               String               @id @default(uuid())
  quizId           String
  studentId        String
  selectedOptionId String?
  voiceMimeType    String?
  voiceData        Bytes?
  voiceDurationMs  Int?
  status           QuizSubmissionStatus @default(SUBMITTED)
  checkedById      String?
  checkedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  voiceUrl         String?
  questionDetails  Json?
  checkedBy        User?                @relation("QuizCheckedBy", fields: [checkedById], references: [id])
  quiz             LessonQuiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student          User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
  @@index([studentId, createdAt])
  @@index([quizId, createdAt])
}

model QuestionSubmission {
  id               String               @id @default(uuid())
  questionId       String
  studentId        String
  selectedOptionId String?
  textAnswer       String?
  voiceMimeType    String?
  voiceData        Bytes?
  voiceDurationMs  Int?
  voiceUrl         String?
  status           QuizSubmissionStatus @default(SUBMITTED)
  checkedById      String?
  checkedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  question         LessonQuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student          User                 @relation(fields: [studentId], references: [id])
  checkedBy        User?                @relation("QuestionCheckedBy", fields: [checkedById], references: [id])

  @@unique([questionId, studentId])
  @@index([studentId, createdAt])
  @@index([questionId, createdAt])
}

model LessonRecording {
  id          String          @id @default(uuid())
  lessonId    String
  lesson      Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  streamId    String
  videoUrl    String
  thumbnailUrl String?
  duration    Int?
  fileSize    BigInt?
  recordedAt  DateTime        @default(now())
  processedAt DateTime?
  status      RecordingStatus @default(PROCESSING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([lessonId])
  @@index([streamId])
  @@index([status])
}

model LessonProgress {
  id               String   @id @default(uuid())
  userId           String
  lessonId         String
  lesson           Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  streamId         String
  watchedSeconds   Int      @default(0)
  totalSeconds     Int?
  completed        Boolean  @default(false)
  lastWatchedAt    DateTime @default(now())
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId, streamId])
  @@index([lessonId])
}

model StudentProgress {
  id                    String   @id @default(uuid())
  userId                String
  streamId              String
  lessonsCompleted      Int      @default(0)
  lessonsTotal          Int      @default(0)
  quizzesPassed         Int      @default(0)
  quizzesTotal          Int      @default(0)
  homeworksAccepted     Int      @default(0)
  homeworksTotal        Int      @default(0)
  averageQuizScore      Float?
  totalWatchTimeSeconds Int      @default(0)
  lastActivityAt        DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, streamId])
  @@index([streamId])
  @@index([userId])
}

model ActivitySession {
  id         String       @id @default(uuid())
  userId     String
  kind       ActivityKind
  streamId   String?
  lessonId   String?
  startedAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())
  endedAt    DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([streamId, startedAt])
  @@index([lessonId, startedAt])
}

model Homework {
  id        String   @id @default(uuid())
  title     String
  lessonId  String
  audioUrl  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model HomeworkAssignment {
  id          String               @id @default(uuid())
  streamId    String
  lessonId    String?
  title       String
  description String?
  type        HomeworkType         @default(TEXT)
  dueAt       DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  lesson      Lesson?              @relation(fields: [lessonId], references: [id])
  stream      Stream               @relation(fields: [streamId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]

  @@index([streamId])
  @@index([lessonId])
}

model HomeworkSubmission {
  id             String                   @id @default(uuid())
  assignmentId   String
  enrollmentId   String
  status         HomeworkSubmissionStatus @default(SUBMITTED)
  grade          Int?
  teacherComment String?
  contentText    String?
  contentUrl     String?
  submittedAt    DateTime                 @default(now())
  checkedAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  assignment     HomeworkAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  enrollment     Enrollment               @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, enrollmentId])
  @@index([enrollmentId])
}

model Notification {
  id          String               @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  link        String?
  read        Boolean              @default(false)
  priority    NotificationPriority @default(NORMAL)
  metadata    Json?
  actionUrl   String?
  actionText  String?
  emailSent   Boolean              @default(false)
  emailSentAt DateTime?
  readAt      DateTime?
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@index([priority, createdAt])
}

model NotificationPreference {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNewLesson          Boolean  @default(true)
  emailHomeworkAssigned   Boolean  @default(true)
  emailHomeworkChecked    Boolean  @default(true)
  emailQuizChecked        Boolean  @default(true)
  emailAnnouncement       Boolean  @default(true)
  emailHomeworkSubmitted  Boolean  @default(true)
  emailQuizSubmitted      Boolean  @default(true)
  emailStudentJoined      Boolean  @default(true)
  emailDigestEnabled      Boolean  @default(false)
  emailDigestTime         Int      @default(540)
  soundEnabled            Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId])
}

model SupportTicket {
  id           String                @id @default(uuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id])
  subject      String
  description  String                @db.Text
  status       SupportTicketStatus   @default(OPEN)
  priority     SupportTicketPriority @default(MEDIUM)
  assignedToId String?
  assignedTo   User?                 @relation("AssignedTickets", fields: [assignedToId], references: [id])
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  resolvedAt   DateTime?
  replies      SupportTicketReply[]

  @@index([userId])
  @@index([assignedToId])
  @@index([status, createdAt])
}

model SupportTicketReply {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  message   String        @db.Text
  isStaff   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model ContentReport {
  id           String              @id @default(uuid())
  reporterId   String
  reporter     User                @relation(fields: [reporterId], references: [id])
  contentType  ContentReportType
  contentId    String
  reason       ContentReportReason
  description  String?             @db.Text
  status       ContentReportStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?               @relation("ReviewedReports", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())

  @@index([reporterId])
  @@index([reviewedById])
  @@index([status, createdAt])
  @@index([contentType, contentId])
}

model ChatRoom {
  id             String        @id @default(uuid())
  type           ChatRoomType
  streamId       String?       @unique
  stream         Stream?       @relation(fields: [streamId], references: [id], onDelete: Cascade)
  participant1Id String?
  participant1   User?         @relation("ChatParticipant1", fields: [participant1Id], references: [id])
  participant2Id String?
  participant2   User?         @relation("ChatParticipant2", fields: [participant2Id], references: [id])
  createdAt      DateTime      @default(now())
  messages       ChatMessage[]

  @@unique([participant1Id, participant2Id])
  @@index([streamId])
}

model ChatMessage {
  id        String    @id @default(uuid())
  roomId    String
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User      @relation(fields: [senderId], references: [id])
  content   String    @db.Text
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([roomId, createdAt])
  @@index([senderId])
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  MODERATOR
}

enum UserStatus {
  PENDING_VERIFICATION
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

enum StreamGenderType {
  MALE_ONLY
  FEMALE_ONLY
  MIXED
}

enum NotificationType {
  NEW_LESSON
  HOMEWORK_ASSIGNED
  HOMEWORK_CHECKED
  QUIZ_CHECKED
  MESSAGE
  ANNOUNCEMENT
  LESSON_STARTING
  LESSON_PUBLISHED
  HOMEWORK_DEADLINE
  HOMEWORK_SUBMITTED
  QUIZ_SUBMITTED
  STUDENT_JOINED
  SUPPORT_TICKET_REPLY
  TEACHER_APPLICATION_APPROVED
  TEACHER_APPLICATION_REJECTED
  STUDENT_REGISTERED
  TEACHER_APPLICATION_SUBMITTED
  ENROLLMENT_REQUEST_SUBMITTED
  ENROLLMENT_REQUEST_APPROVED
  ENROLLMENT_REQUEST_REJECTED
  ENROLLMENT_PAYMENT_REQUIRED
  ENROLLMENT_CONFIRMED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ContentReportType {
  LESSON
  QUIZ
  HOMEWORK
  CHAT_MESSAGE
}

enum ContentReportReason {
  INAPPROPRIATE
  SPAM
  COPYRIGHT
  OTHER
}

enum ContentReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChatRoomType {
  GROUP
  DIRECT
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  REPEATING
  KICKED
}

enum LessonType {
  LIVE
  VIDEO
  TEXT
}

enum QuizType {
  MULTIPLE_CHOICE
  VOICE
}

enum QuestionType {
  MULTIPLE_CHOICE
  TEXT
  VOICE
}

enum QuizSubmissionStatus {
  SUBMITTED
  PASSED
  FAILED
}

enum ActivityKind {
  APP
  LESSON
  LIVE_ROOM
}

enum HomeworkType {
  TEXT
  AUDIO
}

enum HomeworkSubmissionStatus {
  SUBMITTED
  ACCEPTED
  NEEDS_REWORK
  REJECTED
}

enum RecordingStatus {
  PROCESSING
  READY
  FAILED
}

enum EnrollmentRequestStatus {
  PENDING_REVIEW
  APPROVED_PENDING_PAYMENT
  PAYMENT_CONFIRMED
  ACTIVE
  REJECTED
}

model PageContent {
  id        String   @id @default(uuid())
  page      String   @unique
  sections  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([page])
}

model Broadcast {
  id             String               @id @default(uuid())
  title          String
  message        String               @db.Text
  targetAudience Json
  priority       NotificationPriority @default(NORMAL)
  sendEmail      Boolean              @default(false)
  sentById       String
  sentBy         User                 @relation(fields: [sentById], references: [id])
  sentAt         DateTime             @default(now())
  recipientCount Int                  @default(0)
  readCount      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([sentById])
  @@index([sentAt])
}
